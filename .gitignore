# ==========================================
# Voziba Monorepo Root .gitignore
# ==========================================

# 1. Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# 2. Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
*.pem
*.key
*.cert
*.crt
credentials.json

# 3. Build & Compiled Outputs
dist/
**/dist/
.next/
**/.next/
out/
**/out/
build/
**/build/
out-tsc/
bazel-out/
/.angular/
**/.angular/
/.turbo/
**/.turbo/

# 4. Testing & Coverage
coverage/
**/coverage/
.nyc_output/
*.lcov
reports/
__screenshots__/

# 5. Log Files & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
connect.lock
libpeerconnection.log
testem.log

# 6. IDEs, Editors & OS System Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
.history/
*.suo
*.user
*.userosv
*.sln
*.swp
*.swo

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 8. Temporary & Caches
.cache/
**/.cache/
.sass-cache/
.tempmediaStorage/
/typings/
*.tsbuildinfo
